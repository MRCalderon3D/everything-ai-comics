{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://everything-ai-comics.dev/schemas/wardrobe.schema.json",
  "title": "Wardrobe",
  "description": "Wardrobe states of one character (production/characters/<CHAR_ID>/wardrobe.yaml). Panel ledger rows name one of these outfits.",
  "type": "object",
  "additionalProperties": false,
  "required": ["character", "outfits"],
  "properties": {
    "character": {
      "type": "string",
      "pattern": "^CHAR_[A-Z][A-Z0-9_]*$",
      "description": "Character these outfits belong to."
    },
    "outfits": {
      "type": "array",
      "description": "Wardrobe states.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WARD_[A-Z][A-Z0-9_]*$",
            "description": "Wardrobe state ID, e.g. WARD_MARA_OILSKIN."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "The outfit in one generation-ready sentence."
          },
          "layers": {
            "type": "array",
            "description": "Garments, outermost first.",
            "items": { "type": "string", "minLength": 1 }
          },
          "accessories": {
            "type": "array",
            "description": "Worn accessories and equipment.",
            "items": { "type": "string", "minLength": 1 }
          },
          "hands": {
            "enum": ["bare", "gloved", "bandaged"],
            "description": "Hand treatment; gloves never appear or vanish without a wardrobe change."
          },
          "references": {
            "type": "array",
            "description": "Asset IDs that show this outfit.",
            "items": { "type": "string", "pattern": "^(CHAR|LOC|PROP|LOOK)_[A-Z][A-Z0-9_]*_V\\d{2}$" }
          },
          "used_in": {
            "type": "array",
            "description": "Issues where the outfit is worn.",
            "items": { "type": "string", "pattern": "^ISS_\\d{3}$" }
          }
        }
      }
    },
    "notes": { "type": "string", "description": "Free-form notes for people. Never read by scripts." }
  }
}
